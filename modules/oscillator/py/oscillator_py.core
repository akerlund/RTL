CAPI=2:
name: "akerlund::oscillator_py:0"
description: "Oscillator cocotb tests"

filesets:
  tb:
    files:
      - ../math/cordic/rtl/cordic_axi4s_types_pkg.sv
      - ../math/cordic/rtl/cordic_atan_radian_table_pkg.sv
      - ../math/cordic/rtl/cordic_radian_core.sv
      - ../math/cordic/rtl/cordic_radian_top.sv
      - ../math/cordic/rtl/cordic_axi4s_if.sv
      - ../math/long_division/rtl/long_division_core.sv
      - ../math/long_division/rtl/long_division_axi4s_if.sv
      - ../clock_enablers/clock_enable/rtl/clock_enable.sv
      - ../clock_enablers/clock_enable_scaler/rtl/clock_enable_scaler.sv
      - ../clock_enablers/delay_enable/rtl/delay_enable.sv
      - ../rtl/oscillator_types_pkg.sv
      - ../rtl/osc_sin_top.sv
      - ../rtl/osc_saw_core.sv
      - ../rtl/osc_saw_top.sv
      - ../rtl/osc_square_core.sv
      - ../rtl/osc_square_top.sv
      - ../rtl/osc_triangle_core.sv
      - ../rtl/osc_triangle_top.sv
      - ../rtl/oscillator_core.sv
      - ../rtl/oscillator_top.sv
      - ../rtl/oscillator_system.sv
      - tb/tb_top.sv
    file_type: systemVerilogSource

targets:
  sim:
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: cocotb_entry
      mode: cc
      verilator_options:
        - -Wno-fatal
        - --public-flat-rw
        - -Wno-WIDTHTRUNC
        - -Wno-WIDTHEXPAND
        - -Wno-IMPORTSTAR
    filesets:
      - tb
    toplevel: tb_top
