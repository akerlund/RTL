CAPI=2:
name: "akerlund::clock_enable_scaler:0"
description: "Clock enable scaler"

filesets:
  rtl:
    files:
      - rtl/clock_enable_scaler.sv
    file_type: systemVerilogSource

parameters:
  COUNTER_WIDTH_P:
    datatype: int
    default: 32
    paramtype: vlogparam

targets:
  default:
    filesets:
      - rtl


  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-fatal
        - --timing
        - --error-limit
        - "0"
        - -Werror-IMPLICIT
        - -Werror-BLKSEQ
        - -Werror-LATCH
        - -Werror-CASEINCOMPLETE
        - -Wno-UNUSEDSIGNAL
        - -Wno-PINCONNECTEMPTY
    filesets:
      - rtl
    parameters:
      - COUNTER_WIDTH_P
    toplevel: clock_enable_scaler
