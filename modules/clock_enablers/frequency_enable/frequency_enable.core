CAPI=2:
name: "akerlund::frequency_enable:0"
description: "Frequency-based clock enable generator with AXI4-Stream interface"

filesets:
  rtl:
    files:
      - rtl/frequency_enable.sv
    file_type: systemVerilogSource

parameters:
  SYS_CLK_FREQUENCY_P:
    datatype: int
    default: 200000000
    paramtype: vlogparam
  AXI_DATA_WIDTH_P:
    datatype: int
    default: 32
    paramtype: vlogparam
  AXI_ID_WIDTH_P:
    datatype: int
    default: 4
    paramtype: vlogparam
  Q_BITS_P:
    datatype: int
    default: 4
    paramtype: vlogparam
  AXI4S_ID_P:
    datatype: int
    default: 1
    paramtype: vlogparam

targets:
  default:
    filesets:
      - rtl


  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-fatal
        - --timing
        - --error-limit
        - "0"
        - -Werror-IMPLICIT
        - -Werror-BLKSEQ
        - -Werror-LATCH
        - -Werror-CASEINCOMPLETE
        - -Wno-UNUSEDSIGNAL
        - -Wno-PINCONNECTEMPTY
    filesets:
      - rtl
    parameters:
      - SYS_CLK_FREQUENCY_P
      - AXI_DATA_WIDTH_P
      - AXI_ID_WIDTH_P
      - Q_BITS_P
      - AXI4S_ID_P
    toplevel: frequency_enable
