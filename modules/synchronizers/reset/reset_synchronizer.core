CAPI=2:
name: "akerlund::reset_synchronizer:0"
description: "Reset synchronizer"

filesets:
  rtl:
    files:
      - rtl/reset_synchronizer_core.sv
      - rtl/reset_synchronizer.sv
    file_type: systemVerilogSource
    depend:
      - "akerlund::io_synchronizer:0"

targets:
  default:
    filesets:
      - rtl


  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-fatal
        - --timing
        - --error-limit
        - "0"
        - -Werror-IMPLICIT
        - -Werror-BLKSEQ
        - -Werror-LATCH
        - -Werror-CASEINCOMPLETE
        - -Wno-UNUSEDSIGNAL
        - -Wno-PINCONNECTEMPTY
    filesets:
      - rtl
    toplevel: reset_synchronizer
