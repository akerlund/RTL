CAPI=2:
name: "akerlund::axi4s_m2s_arbiter:0"
description: "AXI4-Stream many-to-single arbiter"

filesets:
  rtl:
    files:
      - rtl/axi4s_m2s_arbiter.sv
    file_type: systemVerilogSource

  tb:
    files:
      # Compilation units
      - sv/tb/arb_tb_pkg.sv
      - sv/tc/arb_tc_pkg.sv
      - sv/tb/arb_tb_top.sv
      # Include files (included by tb/tc packages)
      - sv/tb/arb_env.sv: {is_include_file: true}
      - sv/tb/arb_scoreboard.sv: {is_include_file: true}
      - sv/tb/arb_virtual_sequencer.sv: {is_include_file: true}
      - sv/tc/arb_base_test.sv: {is_include_file: true}
      - sv/tc/tc_arb_simple_test.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - "akerlund::vip_bool:0"
      - "akerlund::vip_axi4s_agent:0"
      - "akerlund::vip_clk_rst_agent:0"
      - "akerlund::vip_report_server:0"

parameters:
  NR_OF_MASTERS_P:
    datatype: int
    default: 3
    paramtype: vlogparam
  AXI_DATA_WIDTH_P:
    datatype: int
    default: 32
    paramtype: vlogparam
  AXI_STRB_WIDTH_P:
    datatype: int
    default: 4
    paramtype: vlogparam
  AXI_KEEP_WIDTH_P:
    datatype: int
    default: 4
    paramtype: vlogparam
  AXI_ID_WIDTH_P:
    datatype: int
    default: 4
    paramtype: vlogparam
  AXI_DEST_WIDTH_P:
    datatype: int
    default: 4
    paramtype: vlogparam
  AXI_USER_WIDTH_P:
    datatype: int
    default: 4
    paramtype: vlogparam

targets:
  default:
    filesets:
      - rtl

  uvm:
    filesets:
      - rtl
      - tb
    toplevel: arb_tb_top
    tools:
      vcs:
        vcs_options:
          - -ntb_opts
          - uvm-1.2
        run_options:
          - +UVM_TESTNAME=tc_arb_simple_test
          # 1024 bursts x 128 beats x 3 masters, with randomized 2-10 cycle
          # gaps, comfortably exceeds UVM's 9200 (time-unit) default global
          # timeout -- this is a pre-existing testbench characteristic, not
          # specific to this module's RTL (confirmed unchanged on stock RTL).
          - +UVM_TIMEOUT=50000000,NO

  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-fatal
        - --timing
        - --error-limit
        - "0"
        - -Werror-IMPLICIT
        - -Werror-BLKSEQ
        - -Werror-LATCH
        - -Werror-CASEINCOMPLETE
        - -Wno-UNUSEDSIGNAL
        - -Wno-PINCONNECTEMPTY
    filesets:
      - rtl
    parameters:
      - NR_OF_MASTERS_P
      - AXI_DATA_WIDTH_P
      - AXI_STRB_WIDTH_P
      - AXI_KEEP_WIDTH_P
      - AXI_ID_WIDTH_P
      - AXI_DEST_WIDTH_P
      - AXI_USER_WIDTH_P
    toplevel: axi4s_m2s_arbiter
