CAPI=2:
name: "akerlund::axi4s_s2m_arbiter_py:0"
description: "AXI4-Stream slaves-to-master arbiter cocotb tests"

filesets:
  tb:
    files:
      - ../rtl/axi4s_s2m_arbiter.sv
      - tb/tb_top.sv
    file_type: systemVerilogSource

targets:
  sim:
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: cocotb_entry
      mode: cc
      verilator_options:
        - -Wno-fatal
        - --public-flat-rw
    filesets:
      - tb
    toplevel: tb_top
