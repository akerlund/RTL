CAPI=2:
name: "akerlund::examples:0"
description: "Example/template module for UVM testbench development"

filesets:
  rtl:
    files:
      - rtl/dummy.sv
    file_type: systemVerilogSource

  tb:
    files:
      # Compilation units
      - sv/tb/ex_tb_pkg.sv
      - sv/tc/ex_tc_pkg.sv
      - sv/tb/ex_tb_top.sv
      # Include files (included by tb/tc packages)
      - sv/tc/ex_base_test.sv: {is_include_file: true}
      - sv/tc/tc_display.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - "akerlund::vip_bool:0"
      - "akerlund::vip_report_server:0"

targets:
  default:
    filesets:
      - rtl

  uvm:
    filesets:
      - rtl
      - tb
    toplevel: ex_tb_top
    tools:
      vcs:
        vcs_options:
          - -ntb_opts
          - uvm-1.2
        run_options:
          - +UVM_TESTNAME=tc_display
          - -l
          - tc_display.log
