CAPI=2:
name: "akerlund::switch:0"
description: "Debounced switch core"

filesets:
  rtl:
    files:
      - rtl/switch_core.sv
    file_type: systemVerilogSource
    depend:
      - "akerlund::io_synchronizer:0"

parameters:
  NR_OF_DEBOUNCE_CLKS_P:
    datatype: int
    default: 100000
    paramtype: vlogparam

targets:
  default:
    filesets:
      - rtl


  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-fatal
        - --timing
        - --error-limit
        - "0"
        - -Werror-IMPLICIT
        - -Werror-BLKSEQ
        - -Werror-LATCH
        - -Werror-CASEINCOMPLETE
        - -Wno-UNUSEDSIGNAL
        - -Wno-PINCONNECTEMPTY
    filesets:
      - rtl
    parameters:
      - NR_OF_DEBOUNCE_CLKS_P
    toplevel: switch_core
