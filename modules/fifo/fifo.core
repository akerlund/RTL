CAPI=2:
name: "akerlund::fifo:0"
description: "RAM-backed synchronous FIFO"

filesets:
  rtl:
    files:
      - rtl/fifo.sv
      - rtl/fifo_register.sv
    file_type: systemVerilogSource
    depend:
      - "akerlund::memory_reg:0"
      - "akerlund::memory_ram:0"

  sva:
    files:
      - sva/bind_fifo_register.sva
      - sva/sva_top.sva
    file_type: systemVerilogSource

parameters:
  DATA_WIDTH_P:
    datatype: int
    default: 32
    paramtype: vlogparam
  ADDR_WIDTH_P:
    datatype: int
    default: 3
    paramtype: vlogparam
targets:
  default:
    filesets:
      - rtl
      - sva

  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-fatal
        - --timing
        - --error-limit
        - "0"
        - -Werror-IMPLICIT
        - -Werror-BLKSEQ
        - -Werror-LATCH
        - -Werror-CASEINCOMPLETE
        - -Wno-UNUSEDSIGNAL
        - -Wno-PINCONNECTEMPTY
    filesets:
      - rtl
    parameters:
      - DATA_WIDTH_P
      - ADDR_WIDTH_P
    toplevel: fifo
