CAPI=2:
name: "akerlund::multiplication_py:0"
description: "Multiplication cocotb tests"

filesets:
  tb:
    files:
      - ../rtl/dsp48_nq_multiplier.sv
      - ../rtl/dsp48_nq_multiplier_axi4s_if.sv
      - ../rtl/nq_multiplier.sv
      - ../rtl/nq_multiplier_axi4s_if.sv
      - tb/tb_top.sv
    file_type: systemVerilogSource

targets:
  sim:
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: cocotb_entry
      mode: cc
      verilator_options:
        - -Wno-fatal
        - --public-flat-rw
        - -Wno-WIDTHTRUNC
        - -Wno-WIDTHEXPAND
    filesets:
      - tb
    toplevel: tb_top
