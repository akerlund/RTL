CAPI=2:
name: "akerlund::cordic_py:0"
description: "CORDIC cocotb tests"

filesets:
  tb:
    files:
      - ../rtl/cordic_atan_radian_table_pkg.sv
      - ../rtl/cordic_axi4s_types_pkg.sv
      - ../rtl/cordic_radian_core.sv
      - ../rtl/cordic_radian_top.sv
      - ../rtl/cordic_axi4s_if.sv
      - tb/tb_top.sv
    file_type: systemVerilogSource

targets:
  sim:
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: cocotb_entry
      mode: cc
      verilator_options:
        - -Wno-fatal
        - --public-flat-rw
        - -Wno-WIDTHTRUNC
        - -Wno-WIDTHEXPAND
        - -Wno-IMPORTSTAR
    filesets:
      - tb
    toplevel: tb_top
